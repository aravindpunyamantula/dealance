# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/striv_db?schema=public"

# JWT Secrets
JWT_SECRET="striv-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="striv-refresh-secret-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 / MinIO (for file uploads)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="striv-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS
CORS_ORIGIN="*"
